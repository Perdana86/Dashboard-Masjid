# ---------------------------------------------------------------------------
#  Masjid Dashboard - Production Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to your server and update the values
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
#  DOMAIN CONFIGURATION
# ---------------------------------------------------------------------------
# Ganti dengan domain Anda
DOMAIN=masjid.yourdomain.com
WWW_DOMAIN=www.masjid.yourdomain.com

# API Server (untuk backend services)
API_DOMAIN=api.masjid.yourdomain.com

# PocketBase Admin URL
POCKETBASE_DOMAIN=admin.masjid.yourdomain.com

# ---------------------------------------------------------------------------
#  SSL/TLS Configuration (Let's Encrypt)
# ---------------------------------------------------------------------------
# Set to true untuk production
USE_SSL=true

# Email untuk SSL certificate renewal notifications
SSL_EMAIL=admin@yourdomain.com

# ---------------------------------------------------------------------------
#  API Server Configuration
# ---------------------------------------------------------------------------
# Production API settings
API_PORT=3001
API_HOST=0.0.0.0

# CORS - Ganti dengan domain production Anda
CORS_ORIGIN=https://masjid.yourdomain.com

# Database (jika menggunakan external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/masjid_db

# ---------------------------------------------------------------------------
#  PocketBase Configuration
# ---------------------------------------------------------------------------
PB_PORT=8090
PB_HOST=0.0.0.0
PB_ENCRYPTION_KEY=your-super-secret-encryption-key-change-this

# Admin credentials (change after first login!)
PB_ADMIN_EMAIL=admin@masjid.yourdomain.com
PB_ADMIN_PASSWORD=ChangeMe123!@#SecurePassword

# ---------------------------------------------------------------------------
#  Web Frontend Configuration
# ---------------------------------------------------------------------------
# Vite build settings
VITE_API_SERVER_URL=https://api.masjid.yourdomain.com
VITE_POCKETBASE_URL=https://admin.masjid.yourdomain.com

# App metadata
VITE_APP_NAME="Masjid Dashboard"
VITE_APP_URL=https://masjid.yourdomain.com

# ---------------------------------------------------------------------------
#  Security Settings
# ---------------------------------------------------------------------------
# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT secret (generate random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---------------------------------------------------------------------------
#  Email Configuration (Optional - for notifications)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Masjid Dashboard <noreply@masjid.yourdomain.com>"

# ---------------------------------------------------------------------------
#  Storage Configuration
# ---------------------------------------------------------------------------
# Upload directory
UPLOAD_DIR=/var/www/html/masjid/uploads

# Max upload size (in MB)
MAX_UPLOAD_SIZE=10

# ---------------------------------------------------------------------------
#  Logging & Monitoring
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=/var/log/masjid/app.log

# PM2 settings
PM2_INSTANCE_NAME=masjid-dashboard
PM2_MAX_MEMORY=512M

# ---------------------------------------------------------------------------
#  Backup Configuration
# ---------------------------------------------------------------------------
BACKUP_DIR=/var/backups/masjid
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ---------------------------------------------------------------------------
#  Feature Flags
# ---------------------------------------------------------------------------
ENABLE_PWA=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUTO_BACKUP=true
ENABLE_ANALYTICS=false

# ---------------------------------------------------------------------------
#  Third-party Integrations (Optional)
# ---------------------------------------------------------------------------
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# FACEBOOK_PIXEL_ID=XXXXXXXXXX
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------------------------------------------------------------------------
#  Development vs Production
# ---------------------------------------------------------------------------
# Set NODE_ENV=production untuk production
NODE_ENV=production

# Debug mode (set to false in production!)
DEBUG=false
