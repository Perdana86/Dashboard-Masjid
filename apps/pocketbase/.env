# PocketBase Encryption Key
# Must be exactly 32 characters for AES-256
PB_ENCRYPTION_KEY=ThisIsA32CharacterSecretKey12345

# Superuser credentials
PB_SUPERUSER_EMAIL=admin@admin.com
PB_SUPERUSER_PASSWORD=password123

# Optional: Public URL for file uploads
POCKETBASE_PUBLIC_URL=http://localhost:8090
