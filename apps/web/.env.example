# ---------------------------------------------------------------------------
#  Supabase integration — frontend (Vite) env vars
#  Copy this file to apps/web/.env and fill in your Supabase project values.
#  Vite only exposes vars prefixed with VITE_ to the browser. The anon key is
#  safe to publish; NEVER put the service-role key here.
#
#  These correspond to the requested NEXT_PUBLIC_* names (this project uses
#  Vite, not Next.js, so the prefix is VITE_ instead of NEXT_PUBLIC_):
#    NEXT_PUBLIC_SUPABASE_URL      -> VITE_SUPABASE_URL
#    NEXT_PUBLIC_SUPABASE_ANON_KEY -> VITE_SUPABASE_ANON_KEY
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
#  Supabase integration — server-side (PocketBase process) env vars
#  These are NOT read by Vite. Set them in the PocketBase process environment
#  (see SUPABASE_SETUP.md for how). The service-role key bypasses RLS and must
#  stay server-side only.
#
#    NEXT_PUBLIC_SUPABASE_URL        -> SUPABASE_URL            (same project URL)
#    SUPABASE_SERVICE_ROLE_KEY       -> SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------

# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional: absolute origin for synced file URLs (defaults to in-app proxy path)
# POCKETBASE_PUBLIC_URL=https://your-masjid-domain.com
