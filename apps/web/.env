# ---------------------------------------------------------------------------
#  API Server Configuration
# ---------------------------------------------------------------------------
# Production: Set your API server URL here
# Example: VITE_API_SERVER_URL=https://api.your-masjid-domain.com
# Development: Use Vite proxy path to avoid CORS issues
VITE_API_SERVER_URL=http://localhost:3001

# PocketBase URL (optional)
# For production with Nginx proxy, leave empty to use /pb path
# For separate subdomain, uncomment and set your URL:
# VITE_POCKETBASE_URL=https://admin.masjid.yourdomain.com
POCKETBASE_PUBLIC_URL=http://localhost:8090
