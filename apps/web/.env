# ---------------------------------------------------------------------------
#  API Server Configuration
# ---------------------------------------------------------------------------
# Production: Set your API server URL here
# Example: VITE_API_SERVER_URL=https://api.your-masjid-domain.com
# Development: Use Vite proxy path to avoid CORS issues
VITE_API_SERVER_URL=http://localhost:3001

# PocketBase URL (optional)
# For production with Nginx proxy, leave empty to use /pb path
# For separate subdomain, uncomment and set your URL:
# VITE_POCKETBASE_URL=https://admin.masjid.yourdomain.com

# ---------------------------------------------------------------------------
#  Supabase integration — frontend (Vite) env vars
#  Copy this file to apps/web/.env and fill in your Supabase project values.
#  Vite only exposes vars prefixed with VITE_ to the browser. The anon key is
#  safe to publish; NEVER put the service-role key here.
#
#  These correspond to the requested NEXT_PUBLIC_* names (this project uses
#  Vite, not Next.js, so the prefix is VITE_ instead of NEXT_PUBLIC_):
#    NEXT_PUBLIC_SUPABASE_URL      -> VITE_SUPABASE_URL
#    NEXT_PUBLIC_SUPABASE_ANON_KEY -> VITE_SUPABASE_ANON_KEY
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://rbohsysptwxekjmjwqls.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJib2hzeXNwdHd4ZWtqbWp3cWxzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4NjA4MjMsImV4cCI6MjEwMjQzNjgyM30.7CYkKg_nUT3DTGkIyt5uDh_eVEQQ4uBl9kH4tRZx_AE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJib2hzeXNwdHd4ZWtqbWp3cWxzIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Njg2MDgyMywiZXhwIjoyMTAyNDM2ODIzfQ.kKljGJw77GrjQHg00ddg0hCInmV4tgOgHb4I_RXhSBY

# ---------------------------------------------------------------------------
#  Supabase integration — server-side (PocketBase process) env vars
#  These are NOT read by Vite. Set them in the PocketBase process environment
#  (see SUPABASE_SETUP.md for how). The service-role key bypasses RLS and must
#  stay server-side only.
#
#    NEXT_PUBLIC_SUPABASE_URL        -> SUPABASE_URL            (same project URL)
#    SUPABASE_SERVICE_ROLE_KEY       -> SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------

# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional: absolute origin for synced file URLs (defaults to in-app proxy path)
POCKETBASE_PUBLIC_URL=http://localhost:8090
